{
  "schemaVersion": 1,
  "id": "fastpaintings",
  "version": "${version}",
  "name": "Really Fast Paintings",
  "description": "Converts paintings into non-ticking block-backed decorations for improved performance.",
  "authors": [
    "justbecause"
  ],
  "contact": {},
  "license": "MPL-2.0",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.justbecause.fastpaintings.FastPaintings"
    ],
    "client": [
      "me.justbecause.fastpaintings.client.FastPaintingsClient"
    ]
  },
  "mixins": [
    "fastpaintings.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": ">=${fabric_api_dependency}"
  }
}
